# ── LLM 提供商配置 ──────────────────────────────────────────
# LLM_PROVIDER: 选择使用哪家大模型
#   auto      - 按 CONTRACT_LLM → MINIMAX → OPENAI 顺序自动选择第一个有效 key
#   contract  - 通用 OpenAI 兼容端点（通义千问、DeepSeek、智谱、本地 vLLM 等）
#   minimax   - MiniMax 官方
#   openai    - OpenAI 官方
LLM_PROVIDER=auto

# 通用 OpenAI 兼容端点（默认指向阿里通义千问 DashScope；换成 DeepSeek 等只需改 BASE_URL 和 MODEL）
CONTRACT_LLM_API_KEY=
CONTRACT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CONTRACT_LLM_MODEL=qwen-max
# DeepSeek 示例：
# CONTRACT_LLM_BASE_URL=https://api.deepseek.com/v1
# CONTRACT_LLM_MODEL=deepseek-chat
# 智谱示例：
# CONTRACT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# CONTRACT_LLM_MODEL=glm-4-plus

# MiniMax
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M2.7

# OpenAI 官方
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# LLM 调用参数（所有 provider 共用）
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ── 应用基础配置 ────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=text  # text / json

# ── 向量数据库（Milvus）──────────────────────────────────────
# 知识库/RAG 的唯一向量后端，需先启动服务：docker compose --profile milvus up -d（仓库根目录）
# 单条文块受 Milvus VARCHAR 64KB 上限约束（超限入库被拒并提示拆分）
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=regulations
EMBEDDING_MODEL=shibing624/text2vec-base-chinese
# RAG 检索增强总开关（true 后审查 Agent 才查知识库）
RAG_ENABLED=false
# 嵌入来源：local=sentence-transformers 本地推理（文本不出机，需能加载模型）
#            api  =远程 OpenAI 兼容 /embeddings（默认硅基流动；被嵌入文本会发往服务商）
EMBEDDING_SOURCE=local
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
#EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# api 模式推荐 BAAI/bge-m3（1024 维）；local 模式推荐 BAAI/bge-small-zh-v1.5（512 维）
# 换模型后重启即自动用索引里的原文重建（无需重新上传文档）

# ── 数据库 ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/contract_review
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5433/contract_review
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Celery / Redis ─────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# ── 安全 ───────────────────────────────────────────────────
CORS_ORIGINS=*  # 逗号分隔域名列表，"*" 表示允许所有（生产环境必须修改）
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=20
JWT_SECRET_KEY=dev-secret-change-in-production  # 生产环境必须修改为强密钥

# ── 邮件（注册验证码）─────────────────────────────────────
# REGISTRATION_ENABLED 已退役：注册恒开放，走邮箱验证码。以下三键缺一则发码端点返回 503
# QQ 邮箱：smtp.qq.com / 465，PASSWORD 填授权码（设置→账户→POP3/SMTP 开启后获取）
# 163 邮箱：smtp.163.com / 465，同样填授权码
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_auth_code_here
#SMTP_FROM=            # 留空=与 SMTP_USER 相同

# ── 熔断配置 ───────────────────────────────────────────────
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_RECOVERY_TIMEOUT=60

# ── OpenTelemetry（可选）──────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=fencun-contract
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Local memory checkpoint; configure a persistent backend for restart recovery.
CHECKPOINT_BACKEND=memory
